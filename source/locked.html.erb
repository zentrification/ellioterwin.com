<!DOCTYPE html>
<html>
<head>
  <title>Protected Case Study</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css">
  <style>
    html, body {
      margin: 0;
      padding: 0;
      background-color: #000000;
      color: #ffffff;
    }
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    body > .section {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .title, .subtitle {
      color: #ffffff;
    }
    .button {
      background-color: #ffffff;
      color: #000000;
      border-color: #ffffff;
    }
    .button:hover {
      background-color: #f0f0f0;
      color: #000000;
    }
  </style>
</head>
<body>
  <section class="section">
    <div class="container" style="max-width: 400px;">
      <h1 class="title">Secret!</h1>
      <p class="subtitle">Please enter Password to continue.</p>

      <div class="field">
        <div class="control">
          <input class="input" type="password" id="passwordInput" placeholder="Enter Password" onkeypress="if(event.key==='Enter') checkPassword()">
        </div>
      </div>

      <div class="field">
        <div class="control">
          <button class="button is-dark" onclick="checkPassword()">Unlock</button>
        </div>
      </div>

      <p id="errorMessage" class="help is-danger" style="display: none;">Incorrect password. Please try again.</p>
    </div>
  </section>

 <script>
    function checkPassword() {
      var password = document.getElementById("passwordInput").value;
      
      // CHANGE "MySecretPassword" to your actual password
      if (password === "Password") {
        
        // This creates the digital stamp (cookie) that lasts for 1 day
        document.cookie = "portfolio_auth=" + password + "; path=/; max-age=86400";
        
        // CHANGE "project-x7f9.html" to the hidden file name
        window.location.href = "pitchcraft.html";
        
      } else {
        document.getElementById("errorMessage").style.display = "block";
      }
    }
  </script>
</body>
</html>