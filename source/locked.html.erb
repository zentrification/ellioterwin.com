<!DOCTYPE html>
<html>
<head>
  <title>Protected Case Study</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css">
</head>
<body>
  <section class="section">
    <div class="container" style="max-width: 400px; margin-top: 100px;">
      <h1 class="title">Password Protected</h1>
      <p class="subtitle">Please enter the password to view this case study.</p>

      <div class="field">
        <div class="control">
          <input class="input" type="password" id="passwordInput" placeholder="Enter Password">
        </div>
      </div>

      <div class="field">
        <div class="control">
          <button class="button is-dark" onclick="checkPassword()">Unlock</button>
        </div>
      </div>

      <p id="errorMessage" class="help is-danger" style="display: none;">Incorrect password. Please try again.</p>
    </div>
  </section>

  <script>
    function checkPassword() {
      var password = document.getElementById("passwordInput").value;
      
      // CHANGE "MySecretPassword" to whatever password you want to use
      if (password === "password") {
        
        // CHANGE "project-x7f9.html" to the obscure file name you created in Step 1
        window.location.href = "source/pitchcraft.html.erb";
        
      } else {
        document.getElementById("errorMessage").style.display = "block";
      }
    }
  </script>
</body>
</html>